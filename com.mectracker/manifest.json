{
  "id": "com.mectracker",
  "name": "Mec Tracker",
  "version": "3.3.9",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.0.0"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite",
    "launchProcess": {
      "schemes": [
        "https"
      ],
      "extensions": []
    },
    "network": {
      "domains": [
        "https://api.github.com"
      ]
    }
  },
  "entrypoints": [
    {
      "id": "mectracker.panel",
      "type": "panel",
      "label": {
        "default": "Mec Tracker"
      },
      "minimumSize": {
        "width": 320,
        "height": 400
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 640
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 680
      }
    }
  ]
}
